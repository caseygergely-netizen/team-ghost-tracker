rules_version = '2';

// TEAM GHOST security rules.
// Every read and write requires a signed-in team account (Firebase Auth).
// There are no public reads: even the player list is only visible to the team.
// Accounts are created in the app's one-time "claim your player" flow and
// linked to a player document via the authUid field.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
